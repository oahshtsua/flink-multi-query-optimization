# Defaults sized for local development.
# Any value put in `.env` at the repo root overrides value in this file.

# Flink
TM_COUNT=1          # number of TaskManager containers
TM_SLOTS=8          # task slots per TaskManager
TM_MEMORY=3072m     # total process memory per TaskManager
JM_MEMORY=1600m     # total process memory of the JobManager
PARALLELISM=1       # default parallelism of submitted jobs

# Kafka
KAFKA_PARTITIONS=1  # partitions of auto-created topics;
KAFKA_HEAP=1g       # broker JVM heap
